# Data Source Configuration
DATA_SOURCE=csv  # Options: csv, excel, postgres, mysql, api

# Database Configuration (for authentication - required)
DATABASE_URL=postgresql://username:password@host:port/database

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration - Update with your Vercel frontend URL
ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,https://your-frontend-domain.com

# Application Settings
DEBUG=False
ENVIRONMENT=production

# Database Configuration (if using database for data storage)
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=cio_dashboard
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# External API Configuration (if using external API)
EXTERNAL_API_URL=https://api.example.com
EXTERNAL_API_KEY=your_api_key

# Data Refresh Settings
AUTO_REFRESH_ENABLED=true
REFRESH_INTERVAL_MINUTES=30

# For Pella.app deployment
PORT=8000

# For local development, use:
# DATABASE_URL=postgresql://user:password@localhost:5432/cio_dashboard
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# DEBUG=True
# ENVIRONMENT=development
