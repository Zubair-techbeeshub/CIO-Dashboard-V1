# Production Environment Configuration for AWS EC2 Docker Deployment

# Data Source Configuration
DATA_SOURCE=csv  # Options: csv, excel, postgres, mysql, api

# Firebase Admin SDK Configuration (REQUIRED for Firebase Authentication)
# Get these values from Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_ID=

# Database Configuration (OPTIONAL - for multi-tenant client management)
# Note: Database authentication has been removed. This is only for client metadata.
DATABASE_URL=postgresql://username:password@your-yugabyte-host:5433/cio_dashboard

# CORS Configuration (REQUIRED - Update with your frontend domain)
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-vercel-app.vercel.app

# Application Settings
DEBUG=False
ENVIRONMENT=production

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/cio_dashboard.log

# YugabyteDB Configuration
DB_HOST=your-yugabyte-cluster-host
DB_PORT=5433  # YugabyteDB default port
DB_NAME=cio_dashboard
DB_USER=your_yugabyte_user
DB_PASSWORD=your_secure_yugabyte_password

# External API Configuration (if using external API)
EXTERNAL_API_URL=https://api.example.com
EXTERNAL_API_KEY=your_api_key

# Data Refresh Settings
AUTO_REFRESH_ENABLED=true
REFRESH_INTERVAL_MINUTES=30

# AWS EC2 Docker Settings
PORT=8000

# Health Check Settings
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/docs
