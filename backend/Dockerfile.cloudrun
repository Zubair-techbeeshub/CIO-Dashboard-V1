# Multi-process Docker container for Cloud Run
# Runs both PostgreSQL and FastAPI in a single container using supervisord

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies including PostgreSQL 15 and supervisord
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-15 \
    postgresql-contrib-15 \
    supervisor \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Copy database schema to a known location
COPY ../database_schema.sql /app/database_schema.sql 2>/dev/null || echo "Note: database_schema.sql not in parent directory, checking local"
RUN if [ ! -f /app/database_schema.sql ]; then \
    cp database_schema.sql /app/database_schema.sql 2>/dev/null || echo "Warning: database_schema.sql not found"; \
    fi

# Copy supervisord configuration
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Copy startup script
COPY startup.sh /app/startup.sh
RUN chmod +x /app/startup.sh

# Create necessary directories and set permissions
RUN mkdir -p /var/lib/postgresql/data \
    /var/log/postgresql \
    /var/log/supervisor \
    /app/logs \
    && useradd --create-home --shell /bin/bash app

# Set ownership
RUN chown -R postgres:postgres /var/lib/postgresql /var/log/postgresql \
    && chown -R app:app /app

# Expose port for FastAPI
EXPOSE 8000

# Health check on /docs endpoint
HEALTHCHECK --interval=30s --timeout=30s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/docs || exit 1

# Start with the startup script
CMD ["/app/startup.sh"]
