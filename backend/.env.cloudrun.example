# Cloud Run Environment Variables Template
# Copy this to .env for local testing or set in Cloud Run environment

# Database Configuration (localhost since PostgreSQL runs in same container)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cio_dashboard
DB_USER=postgres
DB_PASSWORD=postgres

# Application Configuration
ENVIRONMENT=production
DEBUG=False

# CORS Configuration (Update with your frontend URL after deploying)
ALLOWED_ORIGINS=https://your-frontend.web.app,https://your-frontend.firebaseapp.com

# JWT Configuration (Generate a secure random key)
JWT_SECRET_KEY=change-me-to-a-secure-random-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Optional: Tenant Configuration
DEFAULT_TENANT=american_logics
